<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net5.0;net10.0</TargetFrameworks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>nrtftree_library</RootNamespace>
    <AssemblyName>nrtftree-library</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>

    <!-- NuGet package metadata -->
    <PackageId>NRtfTree</PackageId>
    <Version>0.5.0</Version>
    <Authors>sgoliver</Authors>
    <Description>NRtfTree is a .NET library to parse, analyze and create RTF documents. Supports net5.0 and net10.0.</Description>
    <PackageTags>rtf;parser;document;nrtftree</PackageTags>
    <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sgolivernet/nrtftree</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sgolivernet/nrtftree</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net5.0'">
    <PackageReference Include="System.Drawing.Common" Version="5.0.3" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>
</Project>
